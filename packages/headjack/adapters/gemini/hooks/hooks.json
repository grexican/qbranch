{
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/dist/headjack.mjs\" hook --platform gemini",
            "timeout": 30000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}/dist/headjack.mjs\" hook session --platform gemini",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}

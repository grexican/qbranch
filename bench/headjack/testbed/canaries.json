{
  "palette-token-names": {
    "shard": 1,
    "pair": "design-tokens",
    "domain": "design",
    "minHits": 2,
    "rules": [
      {
        "id": "mineral-token",
        "re": "--hue-(basalt|quartz|jasper|malachite|cobalt|ochre|slate)-\\d{3}\\b"

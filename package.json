{
  "name": "qbranch",
  "version": "0.3.0",
  "private": true,
  "description": "Q Branch: where the gadgets for AI agents get built and proven. headjack (skills just in time), middleout (API calls, compressed), moneyball (right-sized models), groundhog (lessons that stick).",
  "license": "MIT",
  "author": "Eli Gassert",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.mjs\" \"bench/headjack/test/*.test.mjs\"",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "install-tools": "node scripts/install.mjs",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:hotfix": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:dry": "node scripts/release.mjs patch --dry-run",
    "bench:headjack": "node bench/headjack/src/run.mjs",
    "bench:headjack:generate": "node bench/headjack/src/generate.mjs",
    "bench:headjack:cutoff": "node bench/headjack/src/cutoff.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
